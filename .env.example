# ╔══════════════════════════════════════════════════════════════╗
# ║              Kairos Runtime 环境变量配置                     ║
# ║                                                              ║
# ║  复制此文件为 .env 并填入实际值:                               ║
# ║    cp .env.example .env                                      ║
# ║                                                              ║
# ║  标记 [必填] 的变量必须设置才能启动                             ║
# ║  标记 [可选] 的变量有默认值, 按需修改                           ║
# ╚══════════════════════════════════════════════════════════════╝


# ============================================
#  1. Telegram 连接配置
# ============================================

# [必填] 运行模式: bot (机器人) 或 userbot (用户账号)
TELEGRAM_MODE=bot

# --- Bot 模式 (TELEGRAM_MODE=bot 时需要) ---

# [条件必填] Bot Token, 从 @BotFather 获取
BOT_TOKEN=your_bot_token_here

# --- UserBot 模式 (TELEGRAM_MODE=userbot 时需要) ---

# [条件必填] 从 https://my.telegram.org/apps 获取应用凭据
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# [条件必填] 注册手机号, 含国际区号 (如 +86138xxxx)
TELEGRAM_PHONE=
# [可选] 两步验证密码, 未开启则留空
TELEGRAM_PASSWORD=
# [可选] 会话字符串, 留空则首次运行时自动生成
TELEGRAM_SESSION_STRING=
# [可选] 静默流模式: 流式输出时不触发 "正在输入" 提示 (默认 false)
TELEGRAM_SILENT_STREAM=false

# [推荐] 管理员用户 ID, 用于权限控制 (从 @userinfobot 获取)
OWNER_USER_ID=


# ============================================
#  2. 核心 LLM 模型配置
# ============================================

# [必填] 主对话 LLM 的 API Key (兼容 OpenAI 格式)
API_KEY=your_api_key_here
# [必填] API 基础地址
BASE_URL=https://api.deepseek.com/v1
# [必填] 模型名称
MODEL=deepseek-chat


# ============================================
#  3. 辅助模型配置 (State Daemon)
# ============================================

# --- 摘要/归档用云端模型 ---
# [可选] 用于上下文摘要、归档的独立模型, 留空则使用主模型
STATE_DAEMON_CLOUD_API_KEY=
STATE_DAEMON_CLOUD_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
STATE_DAEMON_CLOUD_MODEL=

# --- Ollama 本地服务 (Embedding & 轻量推理) ---
# [可选] Ollama 服务地址 (默认 http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# [可选] 嵌入向量提供方: ollama (默认)
EMBED_PROVIDER=ollama
# [可选] Ollama 嵌入模型名称
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b


# ============================================
#  4. Probe 群聊被动回复控制
# ============================================

# [可选] 是否启用 Probe Gate 被动回复判定 (默认 true)
TRIGGER_PROBE_GATE=true
# [可选] 全局回复冷却时间 (毫秒), 作为各状态冷却的后备值 (默认 45000)
TRIGGER_PROBE_COOLDOWN_MS=45000
# [可选] 静默判定后的冷却时间 (毫秒, 默认 5000)
TRIGGER_PROBE_SILENT_COOLDOWN_MS=5000
# [可选] 回复判定后的冷却时间 (毫秒, 默认 45000)
TRIGGER_PROBE_RESPOND_COOLDOWN_MS=45000

# [可选] Probe 模型提供方: ollama 或 cloud (默认 ollama)
STATE_DAEMON_PROBE_MODEL_PROVIDER=ollama
# [可选] Probe 使用 Ollama 时的地址和模型
STATE_DAEMON_PROBE_OLLAMA_BASE_URL=
STATE_DAEMON_PROBE_OLLAMA_MODEL=qwen3.5:0.8b
# [可选] Probe 使用云端模型时的配置
STATE_DAEMON_PROBE_CLOUD_API_KEY=
STATE_DAEMON_PROBE_CLOUD_BASE_URL=
STATE_DAEMON_PROBE_CLOUD_MODEL=

# [可选] 群聊回复软上限 (条数), 超过则降低回复概率
# STATE_DAEMON_GROUP_REPLY_SOFT_LIMIT=

# --- 消息触发器 ---
# [可选] 是否响应编辑过的消息 (默认 true)
TRIGGER_EDITED_MESSAGE=true
# [可选] 是否响应私聊消息 (默认 true)
TRIGGER_PRIVATE_CHAT=true


# ============================================
#  5. Enclave 输出行为配置
# ============================================

# [可选] send_message 输出模式: strict (严格, 推荐) | compat (兼容)
# strict: 要求模型显式调用 send_message 工具发送消息
# compat: 直接输出文本作为回复
ENCLAVE_SEND_MESSAGE_MODE=strict
# [可选] strict 模式下长时间等待提示延迟 (毫秒), 0 禁用 (默认 120000)
ENCLAVE_LONG_WAIT_HINT_MS=120000
# [可选] strict 模式下文本回退: 模型未调用 send_message 时自动发送纯文本 (默认 true)
ENCLAVE_STRICT_TEXT_FALLBACK=true


# ============================================
#  6. 自定义 Emoji 转文本 (独立模型)
# ============================================

# [可选] 是否启用自定义 Emoji 图片转文本描述 (默认 false)
CUSTOM_EMOJI_TO_TEXT_ENABLED=false
# [可选] 转换用的视觉模型配置, 留空则使用主模型
CUSTOM_EMOJI_TO_TEXT_MODEL=
CUSTOM_EMOJI_TO_TEXT_BASE_URL=
CUSTOM_EMOJI_TO_TEXT_API_KEY=
# [可选] 最大并发转换数 (默认 3)
CUSTOM_EMOJI_TO_TEXT_MAX_CONCURRENCY=3
# [可选] 动态 Emoji 最大提取帧数 (默认 5)
CUSTOM_EMOJI_TO_TEXT_MAX_FRAMES=5
# [可选] Emoji 描述缓存数据库路径 (默认 data/memoh.db)
CUSTOM_EMOJI_TO_TEXT_DB_PATH=data/memoh.db


# ============================================
#  7. 视觉预处理 (图片描述)
# ============================================

# [可选] 图片描述使用的独立视觉模型
# 留空时依次回退: CUSTOM_EMOJI_TO_TEXT_* → 主模型 (API_KEY/BASE_URL/MODEL)
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=
# [可选] 视觉调试模式, 输出图片处理详情 (默认 false)
VISION_DEBUG=false


# ============================================
#  8. Reranker 语义重排序 (可选)
# ============================================

# [可选] Reranker 服务地址 (默认 http://127.0.0.1:8008/rerank)
# RERANKER_API_URL=http://127.0.0.1:8008/rerank
# [可选] Reranker 请求超时 (毫秒, 默认 2500)
# RERANKER_TIMEOUT_MS=2500
# [可选] Reranker 分配阈值, 低于此分数的结果被丢弃 (默认 0.30)
# RERANKER_ASSIGN_THRESHOLD=0.30


# ============================================
#  9. Evolute 动态工具生成
# ============================================

# [可选] 动态生成工具的模块存放目录
# EVOLUTE_MODULE_DIR=
# [可选] 是否保留生成的模块文件, 设为 1 保留 (默认删除)
# EVOLUTE_KEEP_MODULES=0
# [可选] 允许 evolute 安装的 npm 包白名单 (逗号分隔)
# EVOLUTE_ALLOWED_PACKAGES=


# ============================================
#  10. Logos 会话存储
# ============================================

# [可选] Logos 认证令牌
LOGOS_TOKEN=
# [可选] Logos 任务标识 (默认 state-daemon)
LOGOS_TASK_ID=state-daemon
# [可选] Logos 角色 (默认 admin)
LOGOS_ROLE=admin

# --- L2 会话修剪 ---
# [可选] 是否启用 L2 层会话自动修剪 (默认 true)
LOGOS_SESSION_L2_PRUNE_ENABLED=true
# [可选] 修剪检查间隔 (秒, 默认 1800 即 30 分钟)
LOGOS_SESSION_L2_PRUNE_INTERVAL_SECS=1800
# [可选] 修剪保留时长 (小时, 默认 24)
LOGOS_SESSION_L2_PRUNE_RETENTION_HOURS=24
# [可选] 是否删除未验证的会话记录 (默认 true)
LOGOS_SESSION_L2_PRUNE_DELETE_UNVERIFIED=true


# ============================================
#  11. VFS 虚拟文件系统
# ============================================

# --- VFS 二进制解析器 (从 GitHub Release 下载) ---
# [可选] 固定 VFS 版本号, 留空则自动检测最新 vfs-v* Release
# KAIROS_VFS_VERSION=1.0.0
# [可选] 二进制策略: auto (先 musl 后 gnu) | musl | gnu (默认 auto)
KAIROS_VFS_BIN_STRATEGY=auto
# [可选] 架构覆盖, 留空自动检测: amd64 | arm64
# KAIROS_VFS_ARCH=
# [可选] 二进制缓存目录 (默认 .runtime/bin)
KAIROS_VFS_BIN_DIR=.runtime/bin
# [可选] 自定义 manifest 地址 (用于私有镜像/代理)
# KAIROS_VFS_MANIFEST_URL=
# [可选] VFS 就绪超时 (秒), 等待 VFS socket 创建 (默认 120, docker-compose 中为 1800)
VFS_READY_TIMEOUT_SEC=120


# ============================================
#  12. gRPC 与内部路径配置
# ============================================
# 以下为系统内部通信配置, 通常保持默认值即可

# [可选] Enclave gRPC 监听/连接地址
KAIROS_ENCLAVE_SOCKET=unix:///run/kairos-runtime/sockets/kairos-runtime-enclave.sock
# [可选] VFS gRPC 连接地址
KAIROS_VFS_SOCKET=unix:///run/kairos-runtime/sockets/kairos-runtime-vfs.sock
# [可选] 内存文件根目录
MEMORY_FILES_ROOT=/workspace/.runtime/memory_files
# [可选] 动态工具 (evolutions) 目录 — 必须使用绝对路径
EVOLUTIONS_ROOT=/workspace/.runtime/evolutions
# [可选] 应用配置目录
APPCONFIG_ROOT=.runtime/appconfig
# [可选] 配置 profile 名称 (对应 .runtime/appconfig/profiles/<name>.json)
APPCONFIG_PROFILE=local

# [可选] Enclave 连接重试次数和间隔
# ENCLAVE_CONNECT_RETRIES=120
# ENCLAVE_CONNECT_RETRY_DELAY_MS=500


# ============================================
#  13. Dashboard 控制面板
# ============================================

# [条件必填] Dashboard 访问认证令牌 (启动 dashboard 服务时必须设置)
DASHBOARD_AUTH_TOKEN=
# [可选] Dashboard 监听端口 (默认 8080)
# DASHBOARD_PORT=8080


# ============================================
#  14. Sandbox 沙箱配置
# ============================================

# [可选] 沙箱使用的容器镜像 (默认 debian:slim)
SANDBOX_IMAGE=debian:slim
# [可选] 沙箱空跑模式: 1 不实际创建容器 (调试用, 默认 0)
SANDBOX_DRY_RUN=0


# ============================================
#  15. 调试开关
# ============================================

# [可选] Enclave Agent 循环调试日志 (默认 false)
# 启用后输出每个 streaming event 的详细信息
ENCLAVE_DEBUG=false
# [可选] Session 录入调试: 每条消息写入文件系统 (默认 false)
# 启用后会在 debug 目录写入每条消息的 session control blocks
SESSION_DEBUG=false
# [可选] 记忆召回调试日志 (默认 false)
# STATE_DAEMON_RECALL_DEBUG=false
# [可选] 视觉处理调试 (默认 false)
VISION_DEBUG=false

# [可选] 运行环境
NODE_ENV=development
# [可选] 日志级别
LOG_LEVEL=info
# [可选] 时区
# TZ=Asia/Shanghai
